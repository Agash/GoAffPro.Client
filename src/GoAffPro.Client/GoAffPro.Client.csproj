<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>GoAffPro.Client</PackageId>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Description>A modern .NET client for the GoAffPro Affiliate Marketing API with automatic code generation and event detection.</Description>
    <PackageProjectUrl>https://github.com/Agash/GoAffPro.Client</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>goaffpro;affiliate;marketing;api;client;dotnet</PackageTags>
    <NoWarn>$(NoWarn);CS8981;CA1708</NoWarn>
    <GoAffProGeneratorTargetFramework>net10.0</GoAffProGeneratorTargetFramework>
    <GoAffProSwaggerInitPath>$(MSBuildProjectDirectory)\..\..\openapi\goaffpro-canonical.json</GoAffProSwaggerInitPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoAffPro.Client.Generator\GoAffPro.Client.Generator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated\*.g.cs" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Compile Include="Generated\GoAffProUserClient.g.cs">
      <Visible>false</Visible>
    </Compile>
    <Compile Include="Generated\GoAffProPublicClient.g.cs">
      <Visible>false</Visible>
    </Compile>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\GoAffPro.Client.Generator\build\GoAffPro.Client.Generator.targets" Condition="Exists('$(MSBuildThisFileDirectory)..\GoAffPro.Client.Generator\build\GoAffPro.Client.Generator.targets')" />

</Project>
