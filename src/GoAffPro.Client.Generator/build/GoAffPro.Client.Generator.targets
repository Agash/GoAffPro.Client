<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GoAffProGeneratorTargetFramework Condition="'$(GoAffProGeneratorTargetFramework)' == ''">net8.0</GoAffProGeneratorTargetFramework>
    <GoAffProGeneratorBinDirectory Condition="'$(GoAffProGeneratorBinDirectory)' == ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(GoAffProGeneratorTargetFramework)\</GoAffProGeneratorBinDirectory>
    <GoAffProGeneratorTaskNonce Condition="'$(GoAffProGeneratorTaskNonce)' == ''">$([System.Guid]::NewGuid().ToString('N'))</GoAffProGeneratorTaskNonce>
    <GoAffProGeneratorTaskDirectory Condition="'$(GoAffProGeneratorTaskDirectory)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\GoAffProGeneratorTask\$(GoAffProGeneratorTaskNonce)\</GoAffProGeneratorTaskDirectory>
    <GoAffProGeneratorAssembly Condition="'$(GoAffProGeneratorAssembly)' == ''">$(GoAffProGeneratorTaskDirectory)GoAffPro.Client.Generator.dll</GoAffProGeneratorAssembly>
    <GoAffProSwaggerInitPath Condition="'$(GoAffProSwaggerInitPath)' == ''">$(MSBuildProjectDirectory)\..\..\openapi\swagger-ui-init.js</GoAffProSwaggerInitPath>
  </PropertyGroup>

  <UsingTask TaskName="GoAffPro.Client.Generator.GoAffProClientGeneratorTask" AssemblyFile="$(GoAffProGeneratorAssembly)" />

  <Target Name="PrepareGoAffProGeneratorTask" Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetFramework)' != ''">
    <MakeDir Directories="$(GoAffProGeneratorTaskDirectory)" />
    <ItemGroup>
      <GoAffProGeneratorArtifacts Include="$(GoAffProGeneratorBinDirectory)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(GoAffProGeneratorArtifacts)" DestinationFolder="$(GoAffProGeneratorTaskDirectory)" />
  </Target>

  <Target
    Name="GenerateGoAffProClients"
    BeforeTargets="CoreCompile"
    DependsOnTargets="PrepareGoAffProGeneratorTask"
    Inputs="$(GoAffProSwaggerInitPath);$(GoAffProGeneratorAssembly)"
    Outputs="$(MSBuildProjectDirectory)\Generated\GoAffProUserClient.g.cs;$(MSBuildProjectDirectory)\Generated\GoAffProPublicClient.g.cs"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetFramework)' != ''">
    <GoAffProClientGeneratorTask
      ProjectDirectory="$(MSBuildProjectDirectory)"
      SwaggerInitPath="$(GoAffProSwaggerInitPath)" />
  </Target>

</Project>
