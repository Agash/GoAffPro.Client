<Project>
  <!-- The runtime's own packages follow the target: each framework takes the release band it
       ships with, so a net11.0 consumer gets the .NET 11 libraries and older targets stay on 10.
       Directory.Packages.props names this version. It is set here, after the project body, because a
       project with a single TargetFramework has not set it yet when the props are imported; items,
       PackageVersion among them, are evaluated after every property, so they see this value. -->
  <PropertyGroup>
    <DotNetPackageVersion>10.0.14</DotNetPackageVersion>
    <DotNetPackageVersion
      Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))"
      >11.0.0-rc.3.26522.148</DotNetPackageVersion>
  </PropertyGroup>
  <!-- Evaluated after each project, so IsPackable is already set here; in Directory.Build.props
       it is not, and the condition would never be true. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <!-- Source Link plus a deterministic, source-indexed build: the package page advertises
         it, and a consumer can step into this code from their own debugger. -->
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
  </ItemGroup>
</Project>
